 ;/*++
;
;Copyright (c) Microsoft Corporation All rights Reserved
;
;Module Name:
;
;    SM5705Battery.inf
;
;Abstract:
;
;    INF file for installing Surface Battery Miniclass driver.
;
;--*/

[Version]
Signature="$WINDOWS NT$"
Class=Battery
ClassGuid={72631e54-78a4-11d0-bcf7-00aa00b7b32a}
Provider=%ProviderName%
DriverVer = 06/15/2020,2.35.139.0
CatalogFile=SM5705Battery.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
SM5705Battery.sys  = 1,,

;*****************************************
; Surface Battery Mini Class Install Section
;*****************************************

[Manufacturer]
%ProviderName%=Standard,NT$ARCH$

[Standard.NT$ARCH$]
%SM5705Battery.DeviceDesc% = SM5705Battery_Device, ACPI\SM5705FG

[SM5705Battery_Device.NT]
CopyFiles=SM5705Battery_Device_Drivers
Include=battery.inf
Needs=Battery_Inst

[SM5705Battery_Device_Drivers]
SM5705Battery.sys

;-------------- Service installation

[SM5705Battery_Device.NT.Services]
AddService = SM5705Battery,%SPSVCINST_ASSOCSERVICE%,SM5705Battery_Service_Inst

; -------------- SM5705Battery driver install sections

[SM5705Battery_Service_Inst]
DisplayName    = %SM5705Battery.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\SM5705Battery.sys

;*****************************************
; Literals
;*****************************************

[Strings]
SPSVCINST_ASSOCSERVICE    = 0x00000002
ProviderName              = "Samsung"
DiskId1                   = "Samsung SM5705 Fuel Gauge Mini Class Installation Disk"
SM5705Battery.DeviceDesc = "Samsung SM5705 Fuel Gauge"
SM5705Battery.SVCDESC    = "Samsung SM5705 Fuel Gauge Service"
